GOOGLE_API_KEY=replace-with-your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# Free-tier-safe ingestion defaults; paid tiers can raise the batch size or lower the pause.
GEMINI_EMBEDDING_BATCH_SIZE=90
GEMINI_EMBEDDING_BATCH_PAUSE_SECONDS=61
# Optional: use a different model for the grounding judge.
GEMINI_JUDGE_MODEL=gemini-2.5-flash
